package legends:cosmos;

world cosmos {
  import engine;
  export extension;
}

interface engine {
  use field.{value};

  fire: async func(player: string, kind: string, values: list<value>) -> result<_, string>;
}

interface extension {
  use entry.{entry, entry-definition};
  use field.{value};

  record interaction {
    player: string,
    id: string,
  }

  register-entries: func() -> list<entry-definition>;

  set-active-kinds: func(kinds: list<string>);

  trigger: async func(entry: entry, interaction: interaction) -> result<map<string, list<value>>, string>;
}
