package legends:cosmos;

world cosmos {
  import engine;
  export extension;
}

/// Interface imported by extensions to communicate with the engine.
interface engine {
  use field.{value};

  /// Describes an event to be processed by the engine.
  ///
  /// An extension sends a fire to the engine when it detects an event
  /// that may match entries registered in the engine's library.
  record fire {
    /// UUID of the player who triggered the event.
    player: string,

    /// Kind of the reconstructed entry.
    kind: string,

    /// Values of the reconstructed entry.
    values: list<value>
  }

  /// Notifies the engine that the extension is being loaded.
  ///
  /// Allows the engine to initialize its integration with the extension.
  /// Returns an error if the loading process fails.
  load: async func() -> result<_, string>;

  /// Notifies the engine that the extension is being unloaded.
  ///
  /// Allows the engine to clean up resources associated with the extension.
  /// Returns an error if the unloading process fails.
  unload: async func() -> result<_, string>;

  /// Sends a reconstructed event to the engine.
  ///
  /// The engine processes the event and matches it against its entry library.
  ///
  /// Returns `true` if the event should be canceled, or `false` otherwise.
  /// Returns an error if the event cannot be processed.
  fire-event: async func(fire: fire) -> result<bool, string>;
}

/// Interface exported by extensions for the engine to communicate with them.
interface extension {
  use entry.{entry, entry-definition};

  /// Identifies an interaction associated with a player.
  record interaction {
    /// UUID of the player associated with the interaction.
    player: string,

    /// Unique identifier of the interaction.
    id: string,
  }

  /// Describes an entry execution requested by the engine.
  ///
  /// Contains the entry to execute and the context in which it should run.
  record trigger {
    /// Entry to execute.
    entry: entry,

    /// Interaction associated with the execution.
    interaction: interaction,

    /// Identifier of the task associated with the execution.
    task: string
  }

  /// Requests the registration of the extension's entry definitions.
  ///
  /// Called by the engine when registering the extension.
  /// Returns the definitions of the entries provided by the extension.
  ///
  /// Returns an error if registration fails.
  register: async func() -> result<list<entry-definition>, string>;

  /// Requests the unregistration of the extension's entry definitions.
  ///
  /// Called by the engine when unregistering the extension.
  /// Returns the definitions that were previously registered.
  ///
  /// Returns an error if unregistration fails.
  unregister: async func() -> result<_, string>;

  /// Provides the extension with the currently active entry kinds.
  ///
  /// Called by the engine whenever the set of active kinds changes.
  /// Extensions can use this information to limit event matching
  /// to kinds that are currently required.
  active-kinds: async func(kinds: list<string>) -> result<_, string>;

  /// Requests the execution of an entry.
  ///
  /// Called by the engine to execute an entry provided by the extension.
  /// The trigger contains the entry, its associated interaction and
  /// the task identifier used to track the execution.
  ///
  /// Returns an error if the execution request cannot be processed.
  trigger-entry: async func(trigger: trigger) -> result<_, string>;

  /// Requests the cancellation of an ongoing task.
  ///
  /// Called by the engine when a trigger execution needs to be stopped.
  /// The extension should interrupt the corresponding task and release
  /// any resources associated with it.
  ///
  /// Returns an error if the task cannot be canceled.
  cancel: async func(task: string) -> result<_, string>;
}