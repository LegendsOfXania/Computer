package legends:cosmos;

interface entry {
  use field.{field, value};

  record entry-definition {
    kind: string,
    tags: list<string>,
    fields: list<field>,
    icon: string,
    color: string,
    version: u32,
  }

  record entry {
    id: string,
    kind: string,
    version: u32,
    values: list<value>,
  }
}