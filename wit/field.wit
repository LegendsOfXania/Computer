package legends:cosmos;

interface field {
  record field {
    name: string,
    %flags: map<string, string>,
    kind: field-kind,
  }

  variant field-kind {
    %string,
    int,
    float,
    %bool,
    reference,
    %enum(list<string>),
    %struct(u32),
    %list,
    %map,
    %variant(list<tuple<string, u32>>),
  }

  variant value {
    null,
    %string(string),
    int(s64),
    float(f64),
    %bool(bool),
    reference(string),
    %enum(string),
    %struct(list<string>),
    %list(u32),
    %map(u32),
    %variant(tuple<string, list<string>>),
  }
}