package legends:cosmos;

interface field {
  record field {
    name: string,
    kind: u32,
    %flags: map<string, string>,
  }

  variant field-kind {
    %string,
    int,
    float,
    %bool,
    reference,
    %enum(list<string>),
    %struct(list<u32>),
    %list(u32),
    %map(map<u32, u32>),
    %variant(map<string, map<string, u32>>),
  }
  
  variant value {
    null,
    %string(string),
    int(s64),
    float(f64),
    %bool(bool),
    reference(string),
    %enum(string),
    %struct(map<string, u32>),
    %list(list<u32>),
    %map(map<u32, u32>),
    %variant(tuple<string, map<string, u32>>),
  }
}
